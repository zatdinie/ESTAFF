@model List<ESTAFF.Models.ViewModels.TaskListItemViewModel>
@{
    ViewBag.Title = "All Tasks";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "";
    var selectedClassification = ViewBag.SelectedClassification as string ?? "";
    var employees = ViewBag.Employees as 
        List<ESTAFF.Models.Data.ApplicationUser> ??
        new List<ESTAFF.Models.Data.ApplicationUser>();
    var classifications = ViewBag.Classifications as List<ClassificationOption>
        ?? new List<ClassificationOption>();
}

<!-- Filter -->
<div class="task-filter-bar">

    <!-- Status Pills -->
    @* The status value has to be the TaskStatus enum name — the controller
       parses it with Enum.TryParse, so "In Progress"/"Completed" would be
       ignored. *@
    <div class="status-filter-pills">

        <a href="@Url.Action("Tasks", "Admin", new {
               employeeId = ViewBag.SelectedEmployeeId,
               classification = selectedClassification })"
           class="status-pill-btn @(string.IsNullOrEmpty(selectedStatus) ? "active-filter" : "")">
            All
        </a>

        @foreach (ESTAFF.Models.Data.TaskStatus s in
            Enum.GetValues(typeof(ESTAFF.Models.Data.TaskStatus)))
        {
            <a href="@Url.Action("Tasks", "Admin", new {
                   status = s.ToString(),
                   employeeId = ViewBag.SelectedEmployeeId,
                   classification = selectedClassification })"
               class="status-pill-btn @(selectedStatus == s.ToString() ? "active-filter" : "")">
                @TaskDisplay.StatusLabel(s)
            </a>
        }
    </div>

    <!-- Employee filter -->
    <div class="filter-group">
        <span class="filter-label">Employee</span>
        <select class="filter-select"
                id="employeeFilter"
                onchange="applyFilters()">
            <option value="">All Employees</option>
            @foreach (var emp in employees)
            {
                <option value="@emp.Id"
                    @(ViewBag.SelectedEmployeeId == emp.Id ? "selected" : "")>
                    @emp.UserName
                </option>
            }
        </select>
    </div>

    <!-- Classification filter -->
    <div class="filter-group">
        <span class="filter-label">Classification</span>
        <select class="filter-select"
                id="classificationFilter"
                onchange="applyFilters()">
            <option value="">All Types</option>
            @foreach (var c in classifications)
            {
                <option value="@c.TaskClassificationId"
                        selected="@(selectedClassification == c.TaskClassificationId.ToString())">
                    @c.Name
                </option>
            }
        </select>
    </div>

    <!-- Assign button -->
    <a href="@Url.Action("AssignTask", "Admin")" 
        class="btn-primary-custom ms-auto">
        <i class="fas fa-plus"></i> Assign Task
    </a>

</div>

<!-- Task List -->
<div class="task-table-card">
    <div class="task-table-header">
        <h6>
            <i class="fas fa-list-check"></i> 
            Task
        </h6>
        <span class="task-count-badge">@Model.Count tasks</span>
    </div>

    @if (Model.Count > 0)
    {
        @* The action column is wide by design, so the table scrolls sideways
           on narrow screens rather than being clipped by the card. *@
        <div class="table-scroll">
        <table class="data-table" style="width: 100%">
            <thead>
                <tr>
                    <th style="padding-left:1.5rem">Task</th>
                    <th class="task-concern-col">Concern/Issue</th>
                    <th>Classification</th>
                    <th>Assigned To</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th style="min-width:260px">Action</th>
                    <th>Created </th>
                    @* "Manage", not "Actions" — the Action column above is the
                       flow of actions taken, and two similar headings side by
                       side read as the same thing. *@
                    <th style="padding-right:1.5rem">Manage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    var statusClass = task.StatusClass;

                    var priorityClass = task.Priority.HasValue
                        ? task.Priority.ToString().ToLower()
                        : "";

                    var isOverdue = task.IsOverdue;

                    <tr>
                        <td style="padding-left:1.5rem; max-width:220px">
                            <div style="font-weight:600; color:var(--text-primary);
                                        font-size:0.845rem; white-space:nowrap;
                                        overflow:hidden; text-overflow:ellipsis">
                                @task.Title
                            </div>
                        </td>
                        @* The concern was previously a truncated second line
                           inside the task cell, clipped to one line at 0.72rem.
                           It reads as its own field, so it gets its own column
                           and the room to wrap. *@
                        <td class="task-concern-cell">
                            @if (!string.IsNullOrWhiteSpace(task.Description))
                            {
                                <span title="@task.Description">
                                    @task.Description
                                </span>
                            }
                            else
                            {
                                <span class="task-concern-empty">
                                    Not recorded
                                </span>
                            }
                        </td>
                        <td style="max-width:230px">
                            @Html.Partial("_ClassificationBadge", ClassificationBadgeModel.From(task))
                            @* Live expiry status of the linked CLIP record. *@
                            @if (task.ClipItem != null)
                            {
                                <div style="margin-top:0.3rem">
                                    @Html.Partial("_ClipItemChip", task.ClipItem)
                                </div>
                            }
                        </td>
                        <td>
                            <div style="font-size:0.82rem; font-weight:600;
                                        color:var(--text-primary)">
                                @task.AssignedToName
                            </div>
                            <div style="font-size:0.7rem; color:var(--text-muted);">
                                @task.AssignedToEmpID
                            </div>
                        </td>
                        <td>
                            @if (task.Priority.HasValue)
                            {
                                <span class="badge-pill badge-@priorityClass">
                                    <span class="priority-dot @priorityClass"></span>
                                    @task.Priority
                                </span>
                            }
                            else
                            {
                                <span style="color:var(--text-muted);
                                            font-size:0.78rem">-</span>
                            }
                        </td>
                        <td>
                            <span style="font-size:0.82rem; font-weight:500;
                                         color:@(isOverdue ? "var(--danger)" : "var(--text-secondary)");">
                                @task.DueDate.ToString("MMM dd, yyyy")
                            </span>
                            @if (isOverdue)
                            {
                                <div style="font-size:0.65rem; color:var(--danger);
                                            font-weight:600;">
                                    OVERDUE
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge-pill badge-@statusClass">
                                @TaskDisplay.StatusLabel(task.Status)
                            </span>
                        </td>
                        <td class="action-cell">
                            @Html.Partial("_StatusActionFlow",
                                task.StatusActions)
                        </td>
                        <td>
                            <span style="font-size:0.78rem;
                                         color:var(--text-muted);">
                                @task.CreatedDate.ToString("MMM dd")
                            </span>
                        </td>
                        <td style="padding-right:1.5rem;">
                            <div class="task-actions">
                                <a href="@Url.Action("EditTask", "Admin",
                                       new { id = task.TaskId })"
                                   class="btn-task-action edit"
                                   title="Edit Task">
                                    <i class="fas fa-edit"></i>
                                </a>
                                @using (Html.BeginForm("DeleteTask", "Admin",
                                    new { id = task.TaskId }, FormMethod.Post,
                                    new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn-task-action delete"
                                            title="Delete Task"
                                            onclick="return confirm('Delete \'@task.Title\'?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-list-check"></i>
            </div>
            <h5>No tasks found</h5>
            <p>
                @if (!string.IsNullOrEmpty(selectedStatus))
                {
                    <text>No @selectedStatus.ToLower() tasks found.</text>
                }
                else
                {
                    <text>Assign your first task to get started.</text>
                }
            </p>
            <a href="@Url.Action("AssignTask", "Admin")"
               class="btn-primary-custom mt-2">
                <i class="fas fa-plus"></i> Assign Task
            </a>
        </div>
    }
</div>

@section PageScripts {
    <script>
        function applyFilters() {
            var status = '@selectedStatus';
            var url    = '@Url.Action("Tasks", "Admin")';
            var params = [];

            var employeeId = document.getElementById('employeeFilter').value;
            var classification =
                document.getElementById('classificationFilter').value;

            if (status)         params.push('status=' + encodeURIComponent(status));
            if (employeeId)     params.push('employeeId=' + encodeURIComponent(employeeId));
            if (classification) params.push('classification=' + encodeURIComponent(classification));

            window.location.href = url +
                (params.length ? '?' + params.join('&') : '');
        }
    </script>
}