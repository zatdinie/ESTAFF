@model List<EHS_PORTAL.Areas.ESTAFF.Models.ViewModels.ReportListItemViewModel>
@{
    ViewBag.Title = "Approved Reports";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (Model.Count > 0)
{
    <div class="report-table-card">
        <div class="report-table-header">
            <h6>
                <i class="fas fa-check-circle"></i>
                Reviewed Reports
            </h6>
            <span class="task-count-badge">
                @Model.Count reports
            </span>
        </div>

        @* Scrolls sideways on narrow screens rather than being clipped by the
           card or forcing the page itself to scroll. *@
        <div class="table-scroll">
        <table class="data-table" style="width:100%">
            <thead>
                <tr>
                    <th style="padding-left:1.5rem">Plant</th>
                    <th>Filed by</th>
                    <th>Type</th>
                    <th>Period</th>
                    <th>Status</th>
                    <th>Reviewed</th>
                    <th style="padding-right:1.5rem">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var sc = r.Status.ToString().ToLower();
                    <tr>
                        <td style="padding-left:1.5rem">
                            <div style="font-weight:600;
                                        color:var(--text-primary);
                                        font-size:0.845rem;">
                                @r.PlantLabel
                            </div>
                        </td>
                        @* Provenance, not ownership: the return covers the
                           plant, this is who filed it. *@
                        <td>
                            <div style="font-size:0.82rem;
                                        color:var(--text-secondary);
                                        font-weight:500;">
                                @r.EmpName
                            </div>
                            <div style="font-size:0.72rem;
                                        color:var(--text-muted);">
                                @r.EmpNumber
                            </div>
                        </td>
                        <td>
                            <span style="font-size:0.82rem;
                                         color:var(--text-secondary);
                                         font-weight:500;">
                                @r.ReportType
                            </span>
                        </td>
                        <td>
                            <span style="font-size:0.82rem;
                                         color:var(--text-secondary);">
                                @r.PeriodStart.ToString("MMM dd") –
                                @r.PeriodEnd.ToString("MMM dd, yyyy")
                            </span>
                        </td>
                        <td>
                            <span class="badge-pill badge-@sc">
                                @r.Status
                            </span>
                        </td>
                        <td>
                            <span style="font-size:0.78rem;
                                         color:var(--text-muted);">
                                @(r.ApprovedDate.HasValue
                                    ? r.ApprovedDate.Value
                                        .ToString("MMM dd, yyyy")
                                    : "—")
                            </span>
                        </td>
                        <td style="padding-right:1.5rem">
                            <div class="task-actions">
                                <a href="@Url.Action("ReviewReport",
                                       "Admin", new { id=r.ReportId })"
                                   class="btn-task-action edit"
                                   title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("DownloadReport",
                                       "Admin", new { id=r.ReportId })"
                                   class="btn-task-action edit"
                                   title="Download PDF">
                                    <i class="fas fa-download"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-file-alt"></i>
        </div>
        <h5>No reviewed reports yet</h5>
        <p>
            Approved and rejected reports will
            appear here.
        </p>
    </div>
}