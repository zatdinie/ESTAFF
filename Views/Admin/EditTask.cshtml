@model ESTAFF.Models.ViewModels.EditTaskViewModel
@{
    ViewBag.Title = "Edit Task";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card">
            <h5 class="form-card-title">
                <i class="fas fa-edit"></i>
                Edit Task
            </h5>

            @using (Html.BeginForm("EditTask", "Admin",
                new { id = Model.TaskId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.TaskId)
                @Html.ValidationSummary(true,
                    "This task could not be saved — see the messages below.",
                    new { @class = "alert alert-danger py-2 small" })

                <div class="row g-3">

                    <div class="col-12">
                        @Html.LabelFor(m => m.Title,
                            new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Title,
                            new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Title, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        @{
                            var fields = TaskFormFieldsViewModel.From(Model);
                        }
                        @Html.Partial("_ClassificationField", fields)
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.Description,
                            new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Description,
                            new { @class = "form-control",
                                  rows = 3,
                                  style = "resize:none;" })
                    </div>

                    @* Full width now that the due date has moved: it belongs
                       with the task type, which decides whether it is asked
                       for at all. *@
                    <div class="col-12">
                        @Html.LabelFor(m => m.AssignedToUserId,
                            new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.AssignedToUserId,
                            new SelectList(Model.Employees,
                                "UserId", "Display",
                                Model.AssignedToUserId),
                            "— Select Employee —",
                            new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.AssignedToUserId, "",
                            new { @class = "text-danger small" })
                    </div>

                    @* Task type and the date it decides on — a period for a
                       daily task, a due date for a long-term one. The model
                       goes straight through: this view model implements
                       ITaskPeriodFields. *@
                    @Html.Partial("_ScheduleFields", Model)

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Priority,
                            new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.Priority,
                            new SelectList(
                                Enum.GetValues(typeof(ESTAFF.Models.Data.TaskPriority))
                                    .Cast<ESTAFF.Models.Data.TaskPriority>()
                                    .Select(p => new { Value = (int)p,
                                                       Text  = p.ToString() }),
                                "Value", "Text",
                                (int?)Model.Priority),
                            "— No Priority —",
                            new { @class = "form-control" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Status,
                            new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.Status,
                            new SelectList(
                                Enum.GetValues(typeof(ESTAFF.Models.Data.TaskStatus))
                                    .Cast<ESTAFF.Models.Data.TaskStatus>()
                                    .Select(s => new { Value = (int)s,
                                                       Text  = s.ToString() }),
                                "Value", "Text",
                                (int)Model.Status),
                            new { @class = "form-control" })
                    </div>

                    @* Only recorded when the status actually changes on save. *@
                    <div class="col-12">
                        @Html.LabelFor(m => m.StatusRemark,
                            new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.StatusRemark,
                            new { @class = "form-control",
                                  rows = 2,
                                  maxlength = 500,
                                  placeholder = "Why is the status changing? (optional)",
                                  style = "resize:none;" })
                        <span class="clip-field-hint">
                            Saved with the status change and shown as the task's
                            latest remark. Ignored if the status is unchanged.
                        </span>
                    </div>

                </div>

                @* The status change already on record, so the admin can see
                   what the last person said before overwriting it. *@
                if (ViewBag.LatestStatusRemark != null)
                {
                    <div class="mt-3">
                        <span class="form-label">Latest status remark</span>
                        @Html.Partial("_StatusRemark",
                            (ESTAFF.Models.ViewModels.StatusRemarkViewModel)
                                ViewBag.LatestStatusRemark)
                    </div>
                }

                <hr style="border-color:var(--border-subtle); margin:1.5rem 0;" />

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Tasks", "Admin")"
                       class="btn-cancel">
                        Cancel
                    </a>
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-save me-1"></i>
                        Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>