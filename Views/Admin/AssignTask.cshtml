@model ESTAFF.Models.ViewModels.AssignTaskViewModel
@{
    ViewBag.Title = "Assign Task";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="assign-task-layout">

    <!-- LEFT: Form -->
    <div class="form-card">
        <h5 class="form-card-title">
            <i class="fas fa-plus-circle"></i>
            New Task
        </h5>

        @using (Html.BeginForm("AssignTask", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @* Header text matters: MVC still renders this box whenever
               ModelState is invalid, so without a message an all-property-error
               postback shows an empty red band. *@
            @Html.ValidationSummary(true,
                "This task could not be assigned — see the messages below.",
                new { @class = "alert alert-danger py-2 small" })

            <div class="row g-3">

                <!-- Title -->
                <div class="col-12">
                    @Html.LabelFor(m => m.Title,
                        new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Title,
                        new { @class = "form-control",
                              placeholder = "e.g. Prepare Q3 report",
                              id = "taskTitle",
                              oninput = "updatePreview()" })
                    @Html.ValidationMessageFor(m => m.Title, "",
                        new { @class = "text-danger small" })
                </div>

                <!-- Concern / Issue -->
                <div class="col-12">
                    @Html.LabelFor(m => m.Description,
                        new { @class = "form-label" })
                    @Html.TextAreaFor(m => m.Description,
                        new { @class = "form-control",
                              placeholder = "Describe the concern or issue (optional)...",
                              rows = 3,
                              style = "resize:none;" })
                </div>

                @* Full width now that the due date has moved: it belongs
                   with the task type, which decides whether it is asked for
                   at all. *@
                <div class="col-12">
                    @Html.LabelFor(m => m.AssignedToUserId,
                        new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.AssignedToUserId,
                        new SelectList(Model.Employees, "UserId", "Display"),
                        "— Select Employee —",
                        new { @class = "form-control",
                              id = "assignedTo",
                              onchange = "updatePreview()" })
                    @Html.ValidationMessageFor(m => m.AssignedToUserId, "",
                        new { @class = "text-danger small" })
                </div>

                @* Task type and the date it decides on — a period for a
                   daily task, a due date for a long-term one. The model goes
                   straight through: this view model implements
                   ITaskPeriodFields. *@
                @Html.Partial("_ScheduleFields", Model)

                <!-- Classification, task type, and the optional CLIP item -->
                <div class="col-12">
                    @{
                        var fields = TaskFormFieldsViewModel.From(Model);
                    }
                    @Html.Partial("_ClassificationField", fields)
                </div>

                <!-- Priority -->
                <div class="col-12">
                    @* A fieldset/legend rather than a LabelFor: the label had
                       nowhere to point, because the radios carry a shared name
                       and no id of their own. *@
                    <fieldset class="priority-fieldset">
                        <legend class="form-label">Priority</legend>
                        <div class="priority-options">
                            @foreach (ESTAFF.Models.Data.TaskPriority p in
                                Enum.GetValues(typeof(ESTAFF.Models.Data.TaskPriority)))
                            {
                                var level = p.ToString().ToLower();

                                <label class="priority-choice">
                                    @* checked binds the posted value back, so a
                                       redisplay after a validation failure keeps
                                       the priority the user already chose. *@
                                    <input type="radio"
                                           name="Priority"
                                           value="@((int)p)"
                                           class="priority-radio"
                                           data-level="@level"
                                           checked="@(Model.Priority == p)"
                                           onchange="updatePreview()" />
                                    <span class="priority-option priority-option-@level">
                                        <span class="priority-dot @level"></span>
                                        @p
                                    </span>
                                </label>
                            }
                        </div>
                    </fieldset>
                </div>

            </div>

            <hr style="border-color:var(--border-subtle); margin:1.5rem 0;" />

            <div class="d-flex justify-content-end gap-2">
                <a href="@Url.Action("Tasks", "Admin")"
                   class="btn-cancel">
                    Cancel
                </a>
                <button type="submit" class="btn-submit">
                    <i class="fas fa-paper-plane me-1"></i>
                    Assign Task
                </button>
            </div>
        }
    </div>

    <!-- RIGHT: Live Preview -->
    <div class="task-preview-card">
        <div class="task-preview-title">
            <i class="fas fa-eye"></i> Live Preview
        </div>

        <div class="preview-item">
            <span class="preview-label">Task Title</span>
            <span class="preview-value" id="prev-title"
                  style="color:var(--text-muted); font-weight:400;
                         font-style:italic;">
                Enter a title...
            </span>
        </div>

        <div class="preview-item">
            <span class="preview-label">Assigned To</span>
            <span class="preview-value" id="prev-employee"
                  style="color:var(--text-muted); font-weight:400;
                         font-style:italic;">
                Select employee...
            </span>
        </div>

        @* Due date or work period, whichever the chosen schedule asks for.
           One row rather than two, because the form only ever fills one. *@
        <div class="preview-item">
            <span class="preview-label" id="prev-due-label">Due Date</span>
            <span class="preview-value" id="prev-due"
                  style="color:var(--text-muted); font-weight:400;
                         font-style:italic;">
                Pick a date...
            </span>
        </div>

        <div class="preview-item">
            <span class="preview-label">Classification</span>
            <span id="prev-classification" class="preview-badge-slot"></span>
        </div>

        @* Task type and CLIP item are separate rows because they are separate
           choices: a task has a type, and may additionally cover a CLIP
           record. They shared one row when picking a record was what set the
           type. *@
        <div class="preview-item">
            <span class="preview-label">Task Type</span>
            <span class="preview-value" id="prev-tasktype"
                  style="color:var(--text-muted); font-weight:400;
                         font-style:italic;">
                Not set
            </span>
        </div>

        <div class="preview-item">
            <span class="preview-label">CLIP Item</span>
            <span class="preview-value" id="prev-clip"
                  style="color:var(--text-muted); font-weight:400;
                         font-style:italic;">
                None
            </span>
        </div>

        <div class="preview-item">
            <span class="preview-label">Priority</span>
            @* The placeholder styling lives on an inner element, not on the
               slot: set here it was inherited by the badge, which rendered
               the chosen priority in italic. *@
            <span id="prev-priority" class="preview-badge-slot">
                <span class="preview-empty">Not set</span>
            </span>
        </div>

        <div class="preview-item">
            <span class="preview-label">Status</span>
            <span class="badge-pill badge-pending">Pending</span>
        </div>
    </div>

</div>

@section PageScripts {
    <script>
    // Cascading: Classification → Task List
    $('#classificationDropdown').on('change', function () {
        var classificationId = $(this).val();
        var $taskList = $('#taskListDropdown');
        $taskList.empty().append('<option value="">— Loading... —</option>');

        if (!classificationId) {
            $taskList.empty().append('<option value="">— Select Task —</option>');
            return;
        }

        $.getJSON('@Url.Action("GetTasksByClassification", "Admin")',
            { classificationId: classificationId },
            function (data) {
                $taskList.empty().append('<option value="">— Select Task —</option>');
                $.each(data, function (_, item) {
                    $taskList.append(
                        $('<option>').val(item.value).text(item.text));
                });
            }
        ).fail(function () {
            $taskList.empty().append(
                '<option value="">— Error loading tasks —</option>');
        });
    });

    // The selected priority box is styled by ".priority-radio:checked + ..."
    // in admin.css. It used to be painted here by assembling colours in JS,
    // which also meant the highlight was never restored on a redisplayed form.

    // Classification, CLIP and the schedule feed the preview too, so the
    // panel always reflects the whole form rather than half of it. They are
    // caught here rather than with an oninput on each: two of them are
    // rendered by shared partials, which have no business knowing that this
    // page has a preview panel at all.
    document.addEventListener('change', function (e) {
        if (!e.target.name) return;
        if (e.target.name === 'TaskClassificationId' ||
            e.target.name === 'TaskListId' ||
            e.target.name === 'ClipItemKey' ||
            e.target.name === 'ScheduleType' ||
            e.target.name === 'DueDate' ||
            e.target.name === 'PeriodDate' ||
            e.target.name === 'PeriodStart' ||
            e.target.name === 'PeriodEnd') {
            updatePreview();
        }
    });

    // Live Preview
    function updatePreview() {
        var title    = document.getElementById('taskTitle').value;
        var empSel   = document.getElementById('assignedTo');
        var empText  = empSel.options[empSel.selectedIndex]?.text ?? '';
        var dueInput = document.querySelector('[name="DueDate"]');
        var dueRaw   = dueInput ? dueInput.value : '';
        var priority = document.querySelector('.priority-radio:checked');

        // Title
        var prevTitle = document.getElementById('prev-title');
        if (title) {
            prevTitle.textContent  = title;
            prevTitle.style.color  = 'var(--text-primary)';
            prevTitle.style.fontWeight = '600';
            prevTitle.style.fontStyle  = 'normal';
        } else {
            prevTitle.textContent  = 'Enter a title...';
            prevTitle.style.color  = 'var(--text-muted)';
            prevTitle.style.fontWeight = '400';
            prevTitle.style.fontStyle  = 'italic';
        }

        // Employee
        var prevEmp = document.getElementById('prev-employee');
        if (empSel.value) {
            prevEmp.textContent  = empText;
            prevEmp.style.color  = 'var(--text-primary)';
            prevEmp.style.fontWeight = '600';
            prevEmp.style.fontStyle  = 'normal';
        } else {
            prevEmp.textContent  = 'Select employee...';
            prevEmp.style.color  = 'var(--text-muted)';
            prevEmp.style.fontWeight = '400';
            prevEmp.style.fontStyle  = 'italic';
        }

        // When the task is due, in the terms it is scheduled in: a daily
        // task shows the day and hours it is worked, a long-term one its due
        // date. The form only asks for one of the two, so showing both would
        // leave a row that is always empty.
        var schedule = document.querySelector(
            'input[name="ScheduleType"]:checked');
        // "1" is TaskScheduleType.Daily — the posted value, not a copy of it.
        var isDaily  = !!schedule && schedule.value === '1';

        var prevDue      = document.getElementById('prev-due');
        var prevDueLabel = document.getElementById('prev-due-label');
        var scheduleText = isDaily ? dailyText() : dateText(dueRaw);

        prevDueLabel.textContent = isDaily ? 'Work Period' : 'Due Date';

        if (scheduleText) {
            prevDue.textContent = scheduleText;
            setSolid(prevDue);
        } else {
            prevDue.textContent = isDaily
                ? 'Pick a date and hours...'
                : 'Pick a date...';
            setMuted(prevDue);
        }

        function dateText(raw) {
            if (!raw) return '';

            var d = new Date(raw + 'T00:00:00');
            return d.toLocaleDateString('en-US',
                { month: 'short', day: 'numeric', year: 'numeric' });
        }

        // "08:00:00" as the dropdown posts it; the form offers whole hours,
        // so the seconds are never anything to read.
        function hourText(name) {
            var el = document.querySelector('[name="' + name + '"]');
            return el && el.value ? el.value.substring(0, 5) : '';
        }

        // The day alone is worth showing while the hours are still unchosen —
        // it is already more than "pick a date".
        function dailyText() {
            var dateEl = document.querySelector('[name="PeriodDate"]');
            var date   = dateText(dateEl ? dateEl.value : '');
            var start  = hourText('PeriodStart');
            var end    = hourText('PeriodEnd');

            if (!date) return '';
            if (!start || !end) return date;

            return date + ', ' + start + ' – ' + end;
        }

        // Classification — reuse the badge markup from the task lists so the
        // preview matches what the task will look like once assigned.
        var classInput = document.querySelector(
            '.js-classification-radio:checked');
        var prevClass = document.getElementById('prev-classification');

        if (classInput) {
            var box = classInput.nextElementSibling;
            prevClass.innerHTML =
                '<span class="badge-pill ' +
                box.className.replace('classification-option-box',
                    'badge-classification').replace(/classification-/g,
                    'badge-classification-') + '">' +
                box.textContent.trim() + '</span>';
        } else {
            prevClass.innerHTML =
                '<span class="preview-empty">Not set</span>';
        }

        // Task type — required, so an empty one reads as unfinished.
        var prevType   = document.getElementById('prev-tasktype');
        var listSelect = document.getElementById('TaskListId');

        if (listSelect && listSelect.value) {
            prevType.textContent =
                listSelect.options[listSelect.selectedIndex].text;
            setSolid(prevType);
        } else {
            prevType.textContent = 'Not set';
            setMuted(prevType);
        }

        // CLIP item — optional, so an empty one reads as a deliberate "none"
        // rather than something still to do.
        var prevClip   = document.getElementById('prev-clip');
        var clipSelect = document.getElementById('ClipItemKey');

        if (clipSelect && clipSelect.value) {
            prevClip.textContent =
                clipSelect.options[clipSelect.selectedIndex].text;
            setSolid(prevClip);
        } else {
            prevClip.textContent = 'None';
            setMuted(prevClip);
        }

        function setSolid(el) {
            el.style.color = 'var(--text-primary)';
            el.style.fontWeight = '600';
            el.style.fontStyle = 'normal';
        }

        function setMuted(el) {
            el.style.color = 'var(--text-muted)';
            el.style.fontWeight = '400';
            el.style.fontStyle = 'italic';
        }

        // Priority — the same badge the task will carry once assigned, rather
        // than a one-off built here. The old version appended an alpha suffix
        // to the colour ("var(--primary)" + "20"), which is not a colour: Low
        // and High lost their background and border outright, and only Medium
        // survived because it happened to be a literal hex.
        var prevPriority = document.getElementById('prev-priority');
        if (priority) {
            var level = priority.dataset.level;
            var label = priority.nextElementSibling.textContent.trim();
            prevPriority.innerHTML =
                '<span class="badge-pill badge-' + level + '">' +
                '<span class="priority-dot ' + level + '"></span>' +
                label + '</span>';
        } else {
            prevPriority.innerHTML =
                '<span class="preview-empty">Not set</span>';
        }
    }

    // Render the preview once on load so it matches the form's initial state
    // (including a re-displayed form after a validation failure).
    updatePreview();
    </script>
}