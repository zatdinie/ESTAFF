@model List<ESTAFF.Models.ViewModels.ReportListItemViewModel>
@{
    ViewBag.Title = "Pending Approvals";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (Model.Count > 0)
{
    <div class="report-table-card">
        <div class="report-table-header">
            <h6>
                <i class="fas fa-clock"></i>
                Awaiting Approval
            </h6>
            <span class="task-count-badge">
                @Model.Count pending
            </span>
        </div>

        @* Scrolls sideways on narrow screens rather than being clipped by the
           card or forcing the page itself to scroll. *@
        <div class="table-scroll">
        <table class="data-table" style="width:100%">
            <thead>
                <tr>
                    <th style="padding-left:1.5rem">Plant</th>
                    <th>Filed by</th>
                    <th>Report Type</th>
                    <th>Period</th>
                    <th>Submitted</th>
                    <th style="padding-right:1.5rem">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td style="padding-left:1.5rem">
                            <div style="font-weight:600;
                                        color:var(--text-primary);
                                        font-size:0.845rem;">
                                @r.PlantLabel
                            </div>
                        </td>
                        @* Provenance, not ownership: the return covers the
                           plant, this is who filed it. *@
                        <td>
                            <div style="font-size:0.82rem;
                                        color:var(--text-secondary);
                                        font-weight:500;">
                                @r.EmpName
                            </div>
                            <div style="font-size:0.72rem;
                                        color:var(--text-muted);">
                                @r.EmpNumber
                            </div>
                        </td>
                        <td>
                            <span class="badge-pill badge-submitted">
                                @r.ReportType
                            </span>
                        </td>
                        <td>
                            <span style="font-size:0.82rem;
                                         color:var(--text-secondary);
                                         font-weight:500;">
                                @r.PeriodStart.ToString("MMM dd") –
                                @r.PeriodEnd.ToString("MMM dd, yyyy")
                            </span>
                        </td>
                        <td>
                            <span style="font-size:0.78rem;
                                         color:var(--text-muted);">
                                @(r.SubmittedDate.HasValue
                                    ? r.SubmittedDate.Value
                                        .ToString("MMM dd, yyyy")
                                    : "—")
                            </span>
                        </td>
                        <td style="padding-right:1.5rem">
                            <div class="task-actions">
                                <a href="@Url.Action("ReviewReport",
                                       "Admin", new { id=r.ReportId })"
                                   class="btn-task-action edit"
                                   title="Review">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @using (Html.BeginForm(
                                    "ApproveReport", "Admin",
                                    new { id = r.ReportId },
                                    FormMethod.Post,
                                    new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn-task-action edit"
                                            title="Quick Approve"
                                            style="color:var(--primary);"
                                            onclick="return confirm(
                                                'Approve this report?')">
                                        <i class="fas fa-check"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-clipboard-check"></i>
        </div>
        <h5>All caught up!</h5>
        <p>No reports are waiting for your approval.</p>
    </div>
}