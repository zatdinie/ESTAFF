@using Microsoft.AspNet.Identity
@{
    var userId   = User.Identity.GetUserId();
    var db       = new EHS_PORTAL.Areas.ESTAFF.Models.Data.ApplicationDbContext();
    var appUser  = db.Users.Find(userId);
    var fullName = appUser?.UserName ?? "Employee";
    var empNo    = appUser?.EmpID ?? "";
    var initials = string.Concat(fullName.Split(' ')
        .Where(w => w.Length > 0)
        .Select(w => w[0].ToString().ToUpper()));

    var ctrl   = ViewContext.RouteData.Values["controller"].ToString();
    var action = ViewContext.RouteData.Values["action"].ToString();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - EStaff Admin</title>
    <link rel="shortcut icon" href="~/Areas/ESTAFF/favicon.ico" type="image/x-icon" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" 
          rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" 
          rel="stylesheet" />

    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" 
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" 
          rel="stylesheet" />

    <!-- Your CSS -->
    <link href="~/Areas/ESTAFF/Content/css/layout.css" rel="stylesheet" />
    <link href="~/Areas/ESTAFF/Content/css/shared.css" rel="stylesheet" />
    <link href="~/Areas/ESTAFF/Content/css/admin.css" rel="stylesheet" />
    <link href="~/Areas/ESTAFF/Content/css/employee.css" rel="stylesheet" />
    <link href="~/Areas/ESTAFF/Content/css/clip-picker.css" rel="stylesheet" />
    @RenderSection("PageStyles", required: false)
</head>
<body>

<!-- ======= SIDEBAR ======= -->
<div class="sidebar">

    <div class="sidebar-brand">
        <div class="sidebar-brand-icon">
            <i class="fas fa-layer-group"></i>
        </div>
        <div class="sidebar-brand-text">
            <h5>EStaff</h5>
            <p>Employee Portal</p>
        </div>
    </div>

    <nav class="sidebar-nav">

        <p class="nav-section-label">Main</p>
        <a href="@Url.Action("Index", "Employee")"
           class="nav-link @(ctrl == "Employee" && action == "Index" ? "active" : "")">
            <i class="fas fa-tachometer-alt"></i> Dashboard
        </a>

        <p class="nav-section-label">My Tasks</p>
        <a href="@Url.Action("MyTasks", "Employee")"
           class="nav-link @(action == "MyTasks" ? "active" : "")">
            <i class="fas fa-list-check"></i> All My Tasks
        </a>
        <a href="@Url.Action("CreateTask", "Employee")"
           class="nav-link @(action == "CreateTask" ? "active" : "")">
            <i class="fas fa-plus-circle"></i> Create Task
        </a>
        <a href="@Url.Action("Calendar", "Employee")"
           class="nav-link @(action == "Calendar" ? "active" : "")">
            <i class="fas fa-calendar-alt"></i> Calendar
        </a>
        <p class="nav-section-label">Reports</p>
        <a href="@Url.Action("GenerateReport", "Employee")"
           class="nav-link @(action == "GenerateReport" ? "active" : "")">
            <i class="fas fa-plus-circle"></i> Generate Report
        </a>
        <a href="@Url.Action("PendingReport", "Employee")"
           class="nav-link @(action == "PendingReport" ? "active" : "")">
            <i class="fas fa-circle-check"></i> Report Approval
        </a>
        <a href="@Url.Action("MyReports", "Employee")"
           class="nav-link @(action == "MyReports" ? "active" : "")">
            <i class="fas fa-file-alt"></i> Reports
        </a>

        <p class="nav-section-label">Profile</p>
        <a href="@Url.Action("Profile", "Employee")"
           class="nav-link @(action == "Profile" ? "active" : "")">
            <i class="fas fa-user-circle"></i> My Profile
        </a>

    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <div class="sidebar-avatar">
                <i class="fas fa-user"></i>
            </div>
            <div class="sidebar-user-info">
                <p>@fullName</p>
                <span><i class="fas fa-id-badge me-1"></i>@empNo</span>
            </div>
        </div>
        @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-logout">
                <i class="fas fa-sign-out-alt me-2"></i>Sign Out
            </button>
        }
    </div>

</div>

<!-- ======= MAIN CONTENT ======= -->
<div class="main-content">

    <!-- Topbar -->
    <div class="topbar">
        <div class="topbar-left">
            <h4>@ViewBag.PageTitle</h4>
            <p>@ViewBag.PageSubtitle</p>
        </div>
        <div class="topbar-right">
            <span class="topbar-badge employee">
                <i class="fas fa-user me-1"></i>Employee
            </span>
            <span class="topbar-date">
                <i class="fas fa-calendar-alt me-1"></i>
                @DateTime.Now.ToString("dd MMM yyyy")
            </span>
        </div>
    </div>

    <!-- Flash Messages -->
    <div class="page-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/Areas/ESTAFF/Scripts/estaff-clip.js"></script>
@RenderSection("PageScripts", required: false)
</body>
</html>