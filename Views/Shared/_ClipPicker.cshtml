@using System.Web.Script.Serialization
@using ESTAFF.Models.ViewModels
@model ClipPickerViewModel

@*
    CLIP item dropdown.

    Renders a real <select> first — that is what actually posts, and it works
    on its own if the script never runs. estaff-clip.js then hides it and
    builds the richer list on top (grouped by urgency, searchable, keyboard
    navigable) from the JSON payload below.
*@
@{
    var pickerId = "clip-picker-" + Model.FieldName.ToLower();
    var listId = pickerId + "-list";

    var payload = new JavaScriptSerializer().Serialize(
        Model.Items.Select(i => new
        {
            key           = i.Key,
            kind          = i.KindShortLabel,
            kindLabel     = i.KindLabel,
            icon          = i.KindIcon,
            title         = i.Title,
            subtitle      = i.Subtitle,
            plant         = i.PlantName,
            plantId       = i.PlantId,
            status        = i.ExpiryStatus,
            processStatus = i.ProcessStatus,
            urgency       = i.UrgencyClass,
            expiryDate    = i.ExpiryDateText,
            expiryText    = i.ExpiryText
        }).ToList());
}

<div class="clip-picker"
     id="@pickerId"
     data-reload-url="@Model.ReloadUrl"
     data-reload-trigger="@Model.ReloadTriggerId">

    @* Grouped by plant so the plain <select> is navigable too: the list runs
       to every COF and monitoring record there is, and without the grouping a
       no-JS user would face one flat list of a couple of hundred rows. *@
    <select name="@Model.FieldName"
            id="@Model.FieldName"
            class="form-control clip-picker-native">
        <option value="">— No CLIP item —</option>
        @foreach (var plant in Model.Items
            .GroupBy(i => i.PlantName ?? "Unassigned plant")
            .OrderBy(g => g.Key))
        {
            <optgroup label="@plant.Key">
                @foreach (var item in plant)
                {
                    <option value="@item.Key"
                            selected="@(item.Key == Model.SelectedKey)">
                        @item.OptionLabel
                    </option>
                }
            </optgroup>
        }
    </select>

    <button type="button"
            class="clip-picker-trigger"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls="@listId">
        <span class="clip-picker-trigger-main">
            <span class="clip-picker-trigger-title is-placeholder">
                Select a CLIP item…
            </span>
            <span class="clip-picker-trigger-sub"></span>
        </span>
        <i class="clip-picker-trigger-icon fas fa-chevron-down clip-picker-caret"></i>
    </button>

    <div class="clip-picker-panel">
        <div class="clip-picker-search-wrap">
            <i class="fas fa-search"></i>
            <input type="text"
                   class="clip-picker-search"
                   placeholder="Search by registration, machine, area or plant…"
                   autocomplete="off" />
        </div>

        @* Plant filter. The picker carries every record in CLIP, so plant is
           the first cut most people want — the options are built by
           estaff-clip.js from the payload rather than listed here, so they
           always match whatever the list actually contains. *@
        <div class="clip-picker-filter-wrap">
            <label class="clip-picker-filter-label"
                   for="@(pickerId)-plant">
                Plant
            </label>
            <select class="clip-picker-plant" id="@(pickerId)-plant">
                <option value="">All plants</option>
            </select>
        </div>

        <ul class="clip-picker-list"
            id="@listId"
            role="listbox"
            aria-label="CLIP items, most urgent first"></ul>

        <button type="button" class="clip-picker-clear">
            <i class="fas fa-times me-1"></i> Clear selection
        </button>
    </div>

    <script type="application/json" class="clip-picker-data">@Html.Raw(payload)</script>
</div>
