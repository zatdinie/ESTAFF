@model EHS_PORTAL.Areas.ESTAFF.Models.ViewModels.CreateTaskViewModel
@{
    ViewBag.Title = "Create Task";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="form-card">
            <h5 class="form-card-title">
                <i class="fas fa-plus-circle"></i>
                New Task
            </h5>

            @using (Html.BeginForm("CreateTask", "Employee", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @* Needs a header message: MVC renders this box whenever
                   ModelState is invalid, so an all-property-error postback
                   would otherwise show an empty red band. *@
                @Html.ValidationSummary(true,
                    "This task could not be created — see the messages below.",
                    new { @class = "alert alert-danger py-2 small" })

                <div class="row g-3">

                    @* Colleagues at the same plant, from the controller. Leaving
                       it on the placeholder assigns the task to yourself. *@
                    <div class="col-12">
                        @Html.LabelFor(m => m.AssignedToUserId,
                            new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.AssignedToUserId,
                            new SelectList(Model.Employees, "UserId", "Display",
                                Model.AssignedToUserId),
                            "— Myself —",
                            new { @class = "form-control",
                                id = "assignedTo" })
                        @Html.ValidationMessageFor(m => m.AssignedToUserId, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.Title,
                            new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Title,
                            new { @class = "form-control",
                                placeholder = "What needs to be done?" })
                        @Html.ValidationMessageFor(m => m.Title, "",
                            new { @class = "text-danger small" })
                    </div>
                    
                    <!-- Classification, task type, and (for CLIP) the item picker -->
                    <div class="col-12">
                        @Html.Partial("_ClassificationField",
                            TaskFormFieldsViewModel.From(Model))
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.Description,
                            new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Description,
                            new { @class = "form-control",
                                placeholder = "Describe the concern or issue (optional)...",
                                rows = 3,
                                style = "resize:none;" })
                    </div>

                    @* Task type and the date it decides on — a period for a
                       daily task, a due date for a long-term one. The model
                       goes straight through: this view model implements
                       ITaskPeriodFields. *@
                    @Html.Partial("_ScheduleFields", Model)

                    @* Full width: the due date it used to share the row
                       with is rendered by _ScheduleFields now. *@
                    <div class="col-12">
                        @Html.LabelFor(m => m.Priority,
                            new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.Priority,
                            new SelectList(
                                Enum.GetValues(
                                        typeof(EHS_PORTAL.Areas.ESTAFF.Models.Data.TaskPriority))
                                    .Cast<EHS_PORTAL.Areas.ESTAFF.Models.Data.TaskPriority>()
                                    .Select(p => new {
                                        Value = (int)p,
                                        Text  = p.ToString()
                                    }),
                                "Value", "Text"),
                            "No Priority",
                            new { @class = "form-control" })
                    </div>

                </div>

                <hr style="border-color:var(--border-subtle);
                           margin:1.5rem 0;" />

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("MyTasks","Employee")"
                       class="btn-cancel">
                        Cancel
                    </a>
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-plus me-1"></i>
                        Create Task
                    </button>
                </div>
            }
        </div>
    </div>
</div>

