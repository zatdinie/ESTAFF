@model ESTAFF.Models.ViewModels.CreateTaskViewModel
@{
    ViewBag.Title = "Edit Task";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
    var taskId = (int)ViewBag.TaskId;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="form-card">
            <h5 class="form-card-title">
                <i class="fas fa-edit"></i>
                Edit Task
            </h5>

            @using (Html.BeginForm("EditTask", "Employee",
                new { id = taskId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true,
                    "This task could not be saved — see the messages below.",
                    new { @class = "alert alert-danger py-2 small" })

                <div class="row g-3">

                    <div class="col-12">
                        @Html.LabelFor(m => m.Title,
                            new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Title,
                            new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Title, "",
                            new { @class = "text-danger small" })
                    </div>

                    <!-- Classification, task type, and (for CLIP) the item picker -->
                    <div class="col-12">
                        @Html.Partial("_ClassificationField",
                            TaskFormFieldsViewModel.From(Model))
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.Description,
                            new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Description,
                            new { @class = "form-control",
                                  rows = 3,
                                  style = "resize:none;" })
                    </div>

                    @* Task type and the date it decides on — a period for a
                       daily task, a due date for a long-term one. The model
                       goes straight through: this view model implements
                       ITaskPeriodFields. *@
                    @Html.Partial("_ScheduleFields", Model)

                    @* Full width: the due date it used to share the row
                       with is rendered by _ScheduleFields now. *@
                    <div class="col-12">
                        @Html.LabelFor(m => m.Priority,
                            new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.Priority,
                            new SelectList(
                                Enum.GetValues(
                                    typeof(ESTAFF.Models.Data.TaskPriority))
                                .Cast<ESTAFF.Models.Data.TaskPriority>()
                                .Select(p => new {
                                    Value = (int)p,
                                    Text  = p.ToString()
                                }),
                                "Value", "Text",
                                (int?)Model.Priority),
                            "— No Priority —",
                            new { @class = "form-control" })
                    </div>

                </div>

                <hr style="border-color:var(--border-subtle);
                           margin:1.5rem 0;" />

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("MyTasks","Employee")"
                       class="btn-cancel">
                        Cancel
                    </a>
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-save me-1"></i>
                        Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>