@model EHS_PORTAL.Areas.ESTAFF.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ESTAFF Management System</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/css/auth.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            @* A column class at every breakpoint: a child of .row with none
               inherits the row's negative margin without the matching gutter
               padding, which pushed the card past the viewport on phones. *@
            <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
                <div class="auth-card">

                    <!-- Header Section -->
                    <div class="auth-header">
                        <div class="auth-header-icon">
                            <i class="fas fa-layer-group"></i>
                        </div>
                        <h3>ESTAFF Management System</h3>
                        <p>Sign in to your account</p>
                    </div>

                    <!-- Body Section -->
                    <div class="auth-body">
                        @using (Html.BeginForm("Login", "Account", 
                            new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            @Html.ValidationSummary(true, "",
                                new { @class = "alert alert-danger py-2 small" })

                            if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success py-2 small">
                                    <i class="fas fa-check-circle me-1"></i>
                                    @TempData["SuccessMessage"]
                                </div>
                            }

                            
                            <div class="mb-3">
                                @Html.LabelFor(m => m.EmpID, 
                                    new { @class = "form-label"})
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-id-badge"></i>
                                    </span>
                                    @Html.TextBoxFor(m => m.EmpID,
                                        new {
                                            @class = "form-control",
                                            placeholder = "Enter your employee number",
                                            autocomplete = "username",
                                            autofocus = "autofocus"
                                        })
                                </div>
                                @Html.ValidationMessageFor(m => m.EmpID, "", 
                                    new { 
                                        @class = "text-danger small" 
                                    })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.Password, 
                                    new { 
                                        @class = "form-label" 
                                    })
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                    @* No custom id here: LabelFor renders
                                       for="Password", so overriding the id
                                       broke the label/input pairing — the
                                       label was not clickable and a screen
                                       reader announced an unlabelled field. *@
                                    @Html.PasswordFor(m => m.Password,
                                        new {
                                            @class = "form-control",
                                            placeholder = "Enter your password",
                                            autocomplete = "current-password"
                                        })
                                    <button class="btn btn-outline-secondary"
                                        type="button"
                                        id="togglePassword"
                                        aria-label="Show password"
                                        aria-pressed="false"
                                        aria-controls="Password">
                                        <i class="fas fa-eye" id="toggleIcon"
                                           aria-hidden="true"></i>
                                    </button>
                                </div>
                                @Html.ValidationMessageFor(m => m.Password, "", 
                                    new { @class = "text-danger small" 
                                })
                            </div>

                            
                            <div class="mb-4">
                                <div class="form-check">
                                    @Html.CheckBoxFor(m => m.RememberMe, 
                                        new { 
                                            @class = "form-check-input" 
                                        })
                                    @Html.LabelFor(m => m.RememberMe, 
                                        new { 
                                            @class = "form-check-label" 
                                        })
                                </div>
                            </div>


                            <button type="submit" class="btn btn-auth">
                                <i class="fas fa-sign-in-alt me-2"></i> Sign In
                            </button>

                            <p class="auth-footer-text">
                                <i class="fas fa-info-circle me-1"></i> 
                                Contact your manager if you don't have an account.
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            var input = document.getElementById('Password');
            var icon = document.getElementById('toggleIcon');
            var shown = input.type === 'text';

            input.type = shown ? 'password' : 'text';
            icon.classList.replace(shown ? 'fa-eye-slash' : 'fa-eye',
                                   shown ? 'fa-eye' : 'fa-eye-slash');

            // The button's name has to change with its state, or it keeps
            // announcing "Show password" while the password is on screen.
            this.setAttribute('aria-pressed', shown ? 'false' : 'true');
            this.setAttribute('aria-label', shown ? 'Show password'
                                                  : 'Hide password');
        });
    </script>
</body>
</html>